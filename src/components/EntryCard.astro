---
import LinkList from './LinkList.astro';

interface Props {
  /** Anchor target, so the in-page contents rail can link to this entry. */
  id?: string;
  heading: string;
  headingNote?: string;
  subheading?: string;
  meta?: string;
  dates: string;
  tags?: string[];
  links?: { label: string; url: string }[];
  media?: { src: string; alt: string; caption?: string }[];
}

const {
  id,
  heading,
  headingNote,
  subheading,
  meta,
  dates,
  tags = [],
  links = [],
  media = [],
} = Astro.props;
---

<article
  id={id}
  class="scroll-mt-20 mb-12 border-t border-rule pt-12 first:border-t-0 first:pt-0 last:mb-0"
>
  <header class="mb-4 sm:flex sm:items-start sm:justify-between sm:gap-x-6">
    <div class="min-w-0">
      <h2 class="text-xl">{heading}</h2>
      {headingNote && <p class="mt-0.5 text-sm text-faint italic">{headingNote}</p>}
      {subheading && <p class="mt-1.5 text-base text-ink">{subheading}</p>}
    </div>

    <div class="mt-1.5 shrink-0 font-mono text-xs text-faint sm:mt-1.5 sm:text-right">
      <p>{dates}</p>
      {meta && <p class="mt-1">{meta}</p>}
    </div>
  </header>

  <div class="entry-body">
    <slot />
  </div>

  <slot name="publications" />

  {
    media.length > 0 && (
      <ul class={`mt-5 grid gap-4 ${media.length > 1 ? 'sm:grid-cols-2' : ''}`}>
        {media.map((item) => (
          <li>
            <figure>
              <img
                src={item.src}
                alt={item.alt}
                width={item.width}
                height={item.height}
                loading="lazy"
                decoding="async"
                class="h-auto w-full rounded-md border border-rule"
              />
              {item.caption && (
                <figcaption class="mt-1.5 text-xs text-faint">{item.caption}</figcaption>
              )}
            </figure>
          </li>
        ))}
      </ul>
    )
  }

  <LinkList links={links} />

  {
    tags.length > 0 && (
      <p class="mt-3 font-mono text-xs text-faint">{tags.join(' · ')}</p>
    )
  }
</article>
