---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section
  id={id}
  class="scroll-mt-20 border-t border-rule pt-10 lg:grid lg:grid-cols-[8rem_minmax(0,46rem)] lg:gap-x-10"
>
  <h2
    class="mb-8 font-display text-sm font-semibold tracking-[0.18em] text-faint uppercase lg:sticky lg:top-16 lg:mb-0 lg:self-start"
  >
    {title}
  </h2>
  <div>
    <slot />
  </div>
</section>
