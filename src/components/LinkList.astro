---
interface Props {
  links: { label: string; url: string }[];
}

const { links } = Astro.props;
---

{
  links.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-2">
      {links.map((link) => (
        <li>
          <a
            href={link.url}
            class="inline-block rounded-full border border-rule px-3 py-1 text-xs no-underline transition-colors hover:border-accent hover:bg-accent-soft"
            target="_blank"
            rel="noopener noreferrer"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  )
}
